#!/bin/sh
#SBATCH --job-name={{ job_name }}
#SBATCH --array=1-{{ n_jobs }}
#SBATCH --partition=medium                # Specifying the partition
#SBATCH --time=1-00:00:00                    # Walltime in hh:mm:ss
#SBATCH --cpus-per-task=1                 # Cores per task 
#SBATCH --mem-per-cpu=7168           # Memory per task in MB (1GB)
#SBATCH --output=logs/%x_%A_%a.out        # Standard output log file
#SBATCH --error=logs/%x_%A_%a.err         # Error log file
#SBATCH --mail-type=ALL
#SBATCH --mail-user=renato.panaro@med.uni-goettingen.de

module load gcc/14.2.0
module load r/4.4.1
module load cmake
module load gsl
module load intel-oneapi-tbb

ulimit -v $(( 1024 * 7168 ))
CMQ_AUTH={{ auth }} R --no-save --no-restore -e 'clustermq:::worker("{{ master }}")'